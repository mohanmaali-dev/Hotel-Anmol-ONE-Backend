NODE_ENV=production
APP_TIMEZONE=Asia/Kolkata
PORT=5000
MONGODB_URI=mongodb+srv://restaurant_user:change-me@cluster0.example.mongodb.net/restaurant_management?retryWrites=false&w=majority
MONGODB_RETRY_WRITES=false
FRONTEND_URL=https://restaurant-app.example.com
JWT_SECRET=replace-this-with-your-own-random-secret-before-deployment
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-this-with-a-different-random-secret-before-deployment
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_COOKIE_DAYS=7
JSON_BODY_LIMIT=10kb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
LOGIN_RATE_LIMIT_MAX=10
TRUST_PROXY=1

EMAIL_ENABLED=false
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=notifications@example.com
EMAIL_PASSWORD=replace-with-your-email-password
EMAIL_FROM=Restaurant App <notifications@example.com>

ADMIN_NAME=Restaurant Owner
ADMIN_USERNAME=admin
ADMIN_EMAIL=owner@example.com
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=ChangeThisAdminPassword123!
